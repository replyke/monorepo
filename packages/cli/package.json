{
  "name": "@sublay/cli",
  "version": "7.0.0",
  "private": false,
  "license": "Apache-2.0",
  "author": "Sublay, maintained by Yanay Tsabary",
  "description": "CLI for installing Sublay UI components",
  "keywords": [
    "sublay",
    "cli",
    "components",
    "comments",
    "social",
    "react",
    "react-native",
    "expo",
    "typescript"
  ],
  "bugs": {
    "url": "https://discord.com/invite/REKxnCJzPz"
  },
  "homepage": "https://docs.sublay.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/sublay-io/monorepo.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "bin": {
    "sublay": "dist/index.js"
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts --format esm --watch",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run build && vitest run",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "prompts": "^2.4.2",
    "chalk": "^5.6.2",
    "ora": "^9.3.0",
    "fs-extra": "^11.3.4",
    "node-fetch": "^3.3.2",
    "execa": "^9.6.1",
    "@babel/core": "^7.29.0",
    "@babel/preset-typescript": "^7.28.5",
    "@babel/plugin-syntax-jsx": "^7.28.6"
  },
  "devDependencies": {
    "@types/babel__core": "^7.20.5",
    "@types/node": "^25.9.2",
    "@types/prompts": "^2.4.9",
    "@types/fs-extra": "^11.0.4",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^1.6.1"
  },
  "engines": {
    "node": ">=20.5.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
