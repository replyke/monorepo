{
  "name": "@sublay/js",
  "version": "7.9.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "NOTICE"
  ],
  "description": "Official JavaScript SDK for Sublay",
  "bugs": {
    "url": "https://discord.com/invite/REKxnCJzPz"
  },
  "homepage": "https://docs.sublay.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/sublay-io/monorepo.git",
    "directory": "packages/js"
  },
  "scripts": {
    "build": "tsup src/index.ts --dts --format cjs,esm --clean",
    "build:types": "tsc --emitDeclarationOnly",
    "prepare": "pnpm build && pnpm build:types",
    "test": "jest"
  },
  "author": "Sublay team",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "axios": "^1.15.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^25.9.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.13"
  }
}
