{
  "name": "@sublay/monorepo",
  "version": "7.13.0",
  "license": "Apache-2.0",
  "author": "Sublay, maintained by Yanay Tsabary",
  "description": "Sublay: Build interactive apps with social features like comments, votes, feeds, user lists, notifications, and more.",
  "keywords": [
    "sublay",
    "social",
    "comments",
    "reactions",
    "moderation",
    "reporting",
    "upvotes",
    "downvotes",
    "react",
    "react-native",
    "expo",
    "typescript"
  ],
  "bugs": {
    "url": "https://discord.com/invite/REKxnCJzPz"
  },
  "homepage": "https://sublay.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/sublay-io/monorepo.git"
  },
  "private": false,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "pnpm -r --if-present run test",
    "react:version:patch": "pnpm --filter @sublay/monorepo --filter @sublay/core --filter @sublay/expo --filter @sublay/react-js --filter @sublay/react-native version patch --no-git-tag-version --no-git-checks",
    "react:version:minor": "pnpm --filter @sublay/monorepo --filter @sublay/core --filter @sublay/expo --filter @sublay/react-js --filter @sublay/react-native version minor --no-git-tag-version --no-git-checks",
    "react:build-all": "pnpm --filter @sublay/core run build && pnpm --filter @sublay/react-js run build && pnpm --filter @sublay/react-native run build && pnpm --filter @sublay/expo run build",
    "react:publish-prod": "pnpm react:build-all && pnpm test && pnpm --filter @sublay/core --filter @sublay/expo --filter @sublay/react-js --filter @sublay/react-native publish --no-git-checks",
    "react:publish-beta": "pnpm react:build-all && pnpm test && pnpm --filter @sublay/core --filter @sublay/expo --filter @sublay/react-js --filter @sublay/react-native publish --tag beta --no-git-checks",
    "react:publish-prod:patch": "pnpm react:version:patch && pnpm react:publish-prod",
    "react:publish-prod:minor": "pnpm react:version:minor && pnpm react:publish-prod",
    "react:publish-beta:patch": "pnpm react:version:patch && pnpm react:publish-beta",
    "react:publish-beta:minor": "pnpm react:version:minor && pnpm react:publish-beta",
    "ui-core:version:patch": "pnpm --filter @sublay/ui-core-react-js --filter @sublay/ui-core-react-native version patch --no-git-tag-version --no-git-checks",
    "ui-core:version:minor": "pnpm --filter @sublay/ui-core-react-js --filter @sublay/ui-core-react-native version minor --no-git-tag-version --no-git-checks",
    "ui-core:publish-prod": "pnpm --filter @sublay/ui-core-react-js --filter @sublay/ui-core-react-native run build && pnpm --filter @sublay/ui-core-react-js --filter @sublay/ui-core-react-native publish --no-git-checks",
    "ui-core:publish-beta": "pnpm --filter @sublay/ui-core-react-js --filter @sublay/ui-core-react-native run build && pnpm --filter @sublay/ui-core-react-js --filter @sublay/ui-core-react-native publish --tag beta --no-git-checks",
    "ui-core:publish-prod:patch": "pnpm ui-core:version:patch && pnpm ui-core:publish-prod",
    "ui-core:publish-prod:minor": "pnpm ui-core:version:minor && pnpm ui-core:publish-prod",
    "ui-core:publish-beta:patch": "pnpm ui-core:version:patch && pnpm ui-core:publish-beta",
    "ui-core:publish-beta:minor": "pnpm ui-core:version:minor && pnpm ui-core:publish-beta",
    "cli:version:patch": "pnpm --filter @sublay/cli version patch --no-git-tag-version --no-git-checks",
    "cli:version:minor": "pnpm --filter @sublay/cli version minor --no-git-tag-version --no-git-checks",
    "cli:publish-prod": "pnpm --filter @sublay/cli run build && pnpm --filter @sublay/cli publish --no-git-checks",
    "cli:publish-beta": "pnpm --filter @sublay/cli run build && pnpm --filter @sublay/cli publish --tag beta --no-git-checks",
    "cli:publish-prod:patch": "pnpm cli:version:patch && pnpm cli:publish-prod",
    "cli:publish-prod:minor": "pnpm cli:version:minor && pnpm cli:publish-prod",
    "cli:publish-beta:patch": "pnpm cli:version:patch && pnpm cli:publish-beta",
    "cli:publish-beta:minor": "pnpm cli:version:minor && pnpm cli:publish-beta"
  },
  "devDependencies": {
    "@types/node": "^20.14.5",
    "@types/react": "^18.0.0",
    "react": "^18.0.0",
    "react-native": "^0.79.2",
    "rimraf": "^6.0.1",
    "typescript": "^6.0.3"
  }
}
